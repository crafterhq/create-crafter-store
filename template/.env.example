# Copy this file to .env.local and fill in the values.
# Use test keys (cp_pk_test_..., cp_sk_test_...) while you build; switch to live keys to go live.

# Your store id (dashboard -> Headless and API). Used to read products and categories.
CRAFTER_STORE_ID=

# production | development. Selects the Crafter API hosts for the catalog and checkout.
CRAFTER_ENV=production

# Publishable key (cp_pk_test_... / cp_pk_live_...). Safe in the browser.
NEXT_PUBLIC_CRAFTER_PUBLISHABLE_KEY=

# Secret key (cp_sk_test_... / cp_sk_live_...). Server only: never prefix it with NEXT_PUBLIC_.
CRAFTER_SECRET_KEY=

# Return signing secret (crs_...), dashboard -> Headless and API. Verifies the signed return to /success.
CRAFTER_RETURN_SECRET=

# Webhook endpoint secret (whsec_...), shown when you add https://<your-site>/api/webhooks/crafter in the dashboard.
CRAFTER_WEBHOOK_SECRET=

# Optional: the public URL of this site (e.g. https://shop.example.com). Defaults to the request origin.
# Return URLs are built from it and must be in the store's allowed origins.
APP_URL=

# Optional: override the catalog API base URL (defaults to https://api.crafter.net.tr, or
# https://dev-api.crafter.net.tr when CRAFTER_ENV=development).
CRAFTER_STORE_API_URL=
